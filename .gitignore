# Live store, written at runtime by Config.Database.Mode = 'json'.
# The directories themselves are tracked (see crimson-hitman/data/README.md);
# what the server writes into them is not.
crimson-hitman/data/store.json*
crimson-hitman/data/records.json*
crimson-hitman/data/heartbeat.json
crimson-hitman/data/contracts/*.json
crimson-hitman/data/contracts/.writable
crimson-hitman/data/audit-*.jsonl
# Kill photos kept on the server (Config.Completion.PhotoStorage = 'server').
# Photographs of bodies, for one client's eyes once: never committed.
crimson-hitman/data/photos/*.webp
crimson-hitman/data/photos/*.jpg
crimson-hitman/data/photos/*.png
# And the ones kept for their client in the app, and which storage mode's
# records name them.
crimson-hitman/data/photos/kept/
crimson-hitman/data/photos/.mode

# Throwaway probes. A one-off spec plus a copy of the runner with its suite
# list narrowed to that spec is how a question about this code gets asked:
# write it, run it, read the answer, delete it. Anything worth keeping gets
# moved into a real suite and registered in tests/run.lua, so what is left
# under these names is by definition scratch — and three times now it has
# ended up staged by a `git add -A` and had to be taken back out.
tests/_probe*.lua
tests/zz_*.lua
zz_*.lua

# Worktrees created for isolated subagent runs. Never part of the repo.
.claude/worktrees/
